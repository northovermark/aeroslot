# Hosted site: set these server-side through hosting settings, not client-side.
FL3XX_API_BASE_URL=https://your-fl3xx-api-host.example/
FL3XX_API_TOKEN=replace_with_operator_token
FL3XX_OPERATOR_ID=your_operator_id
INVENTORY_SYNC_TOKEN=replace_with_random_high_entropy_secret
OPERATOR_USER_IDS=

# Separate, not-deployed Node/Postgres reference service, if you build it out.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aeroslot
WEB_ORIGIN=http://localhost:3000
PORT=4001
INTERNAL_EVENT_TOKEN=

# Future payments, not consumed by the current hosted site.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
